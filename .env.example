# Required — Resend API key for the contact form
RESEND_API_KEY=

# Required for the sender address in Resend.
# For free accounts, this is usually the verified email or onboarding@resend.dev.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional override for where messages are delivered.
# Defaults to the email in src/data/config.ts.
RESEND_TO_EMAIL=gawandkunal2803@gmail.com

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=
